# Server
PORT=5001
JWT_SECRET=replace-with-a-long-random-string

# Database
# Real PostgreSQL (recommended for submission/deployment).
# Use the port your PostgreSQL server actually listens on (default 5432).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brainroyale
# auto = try PostgreSQL first, then fall back to the embedded PGlite database
DB_DRIVER=auto
DB_FALLBACK=true
# PGLITE_DIR=./.pgdata

# External puzzle provider
BANANA_API=https://marcconrad.com/uob/banana/api.php
NODE_ENV=development

# Debug: expose the puzzle answer to the browser console (set false to hide)
SHOW_ANSWERS=true
