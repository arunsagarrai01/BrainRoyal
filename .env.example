# ─────────────────────────────────────────────────────────────
# Quiz Battle Arena — root environment reference
# Copy the relevant blocks into backend/.env and frontend/.env
# ─────────────────────────────────────────────────────────────

# ========== BACKEND (backend/.env) ==========

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quiz_battle_arena?schema=public"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Backend HTTP/Socket.IO port
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend URL)
CLIENT_ORIGIN="http://localhost:5173"

# Node environment: development | production
NODE_ENV="development"

# ========== FRONTEND (frontend/.env) ==========

# Base URL of the backend REST API
VITE_API_URL="http://localhost:4000/api"

# Base URL of the backend Socket.IO server
VITE_SOCKET_URL="http://localhost:4000"
